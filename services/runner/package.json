{
  "name": "@algoreflex/runner",
  "version": "0.1.0",
  "description": "Secure C++ compilation and execution runner boundary for AlgoReflex",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@algoreflex/contracts": "workspace:*",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@algoreflex/config": "workspace:*",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
