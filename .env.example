# ==============================================================================
# AlgoReflex Environment Configuration Template
# NOTE: Never commit sensitive credentials or real production secrets!
# Copy this file to .env for local development.
# ==============================================================================

# Application API
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase compatible)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algoreflex?sslmode=disable

# Future Isolated Runner Service (M1+)
RUNNER_SERVICE_URL=http://localhost:4050
# Set the same long, random value for API and runner locally. This is an
# example placeholder only; never commit a real production token.
RUNNER_SHARED_TOKEN=replace-with-a-long-random-local-token
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4050
# Development may use a local tag. Production must use an approved image digest.
RUNNER_IMAGE=algoreflex-cpp-runner:1.0.0

# Web Frontend (Vite)
VITE_API_URL=http://localhost:4000
