{
  "name": "@algoreflex/problem-schema",
  "version": "0.1.0",
  "description": "Problem, test case, constraint, and hint schemas for AlgoReflex",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@algoreflex/contracts": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@algoreflex/config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
